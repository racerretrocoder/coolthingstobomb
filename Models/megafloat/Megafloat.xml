  <!-- doors -->
  <animation>
    <type>pick</type>
    <object-name>door1fr</object-name>
    <object-name>door1fl</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <interval-sec>0.2</interval-sec>
      <binding>
        <condition>
          <equals>
            <property>sim/multiplay/generic/float[1]</property>
            <value>0</value>
          </equals>
        </condition>
        <command>nasal</command>
        <script>
          setprop("sim/multiplay/chat","LH1, open sesame");
        </script>
      </binding>
      <binding>
        <condition>
          <not-equals>
            <property>sim/multiplay/generic/float[1]</property>
            <value>0</value>
          </not-equals>
        </condition>
        <command>nasal</command>
        <script>
          setprop("sim/multiplay/chat","LH1, close sesame");
        </script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>rfe</tooltip-id>
        <label>Open/Close LH1 Doors</label>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>door1fl</object-name>
    <property>sim/multiplay/generic/float[1]</property>
    <factor>-20</factor>
    <offset-m>0</offset-m>
    <axis>
      <x> 1 </x>
